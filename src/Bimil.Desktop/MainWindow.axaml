<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Bimil"
    x:Class="Bimil.MainWindow"
    x:DataType="local:ThemeImageResources"
    Width="800" Height="600"
    Icon="/Assets/App.ico"
    Title="Bimil">

    <DockPanel>
        <!-- Toolbar -->
        <Grid Name="mnu" DockPanel.Dock="Top" ColumnDefinitions="Auto, Auto, Auto, *, Auto">
            <Grid.Styles>
                <Style Selector="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="CornerRadius" Value="0" />
                    <Setter Property="Height" Value="24" />
                    <Setter Property="Width" Value="NaN" />
                    <Setter Property="Padding" Value="2" />
                </Style>
                <Style Selector="Button /template/ ContentPresenter">
                    <Setter Property="Transitions">
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.13"></TransformOperationsTransition>
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="Button:disabled /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemChromeHighColor}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>
                <Style Selector="Button:pressed /template/ ContentPresenter">
                    <Setter Property="Padding" Value="3 3 1 1" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="MenuItem.DropDown:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource MenuTextEnabledForeground}" />
                </Style>
                <Style Selector="MenuItem">
                    <Setter Property="Foreground" Value="{DynamicResource MenuTextEnabledForeground}" />
                </Style>
                <Style Selector="MenuItem">
                    <Setter Property="FontSize" Value="12" />
                </Style>
                <Style Selector="MenuItem.DropDown">
                    <Setter Property="FontSize" Value="8" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Style Selector="MenuItem.DropDown:pointerover">
                    <Setter Property="Foreground" Value="{DynamicResource MenuTextEnabledForeground}" />
                </Style>
                <Style Selector="Label">
                    <Setter Property="Height" Value="24" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Foreground" Value="{DynamicResource MenuTextEnabledForeground}" />
                </Style>
            </Grid.Styles>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="2">
                <Button Name="mnuFileNew" ToolTip.Tip="New file (Ctrl+N)">
                    <Image Name="imgMenuFileNew" Source="{Binding FileNew}" />
                </Button>
                <Button Name="mnuFileOpenHead" ToolTip.Tip="Open file (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding FileOpen}" />
                        <Menu>
                            <MenuItem Header="▼" Classes="DropDown" Name="mnuFileOpenDropDown" SubmenuOpened="mnuFileOpen_SubmenuOpened">
                                <MenuItem Name="mnuFileOpen" Header="Open…" />
                                <MenuItem Header="-" IsVisible="false" />
                            </MenuItem>
                        </Menu>
                    </StackPanel>
                </Button>
                <Button Name="mnuFileSaveHead" IsEnabled="false" ToolTip.Tip="Save file (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding FileSave}" />
                        <Menu>
                            <MenuItem Header="▼" Classes="DropDown" Name="mnuFileSaveDropDown">
                                <MenuItem Header="Save" Name="mnuFileSave" />
                                <MenuItem Header="Save As…" Name="mnuFileSaveAs" />
                            </MenuItem>
                        </Menu>
                    </StackPanel>
                </Button>
                <Button Name="mnuFilePropertiesHead" IsEnabled="false" ToolTip.Tip="File properties (Alt+Enter)">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding FileEdit}" />
                        <Menu>
                            <MenuItem Header="▼" Classes="DropDown" SubmenuOpened="mnuFileProperties_SubmenuOpened">
                                <MenuItem Header="Properties…" Name="mnuFileProperties" ToolTip.Tip="Edit file properties" />
                                <MenuItem Header="-" />
                                <MenuItem Header="Change Password…" Name="mnuFilePropertiesPassword" ToolTip.Tip="Change file's password" />
                                <MenuItem Header="Read-only" Name="mnuFilePropertiesReadonly" ToolTip.Tip="Controls if file is read-only or not" />
                            </MenuItem>
                        </Menu>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8 0 0 0">
                <Button Name="mnuItemAdd" IsEnabled="false">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding ItemAdd}" />
                        <Label>Add</Label>
                    </StackPanel>
                </Button>
                <Button Name="mnuItemView" IsEnabled="false">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding ItemView}" />
                        <Label>View</Label>
                    </StackPanel>
                </Button>
                <Button Name="mnuItemEdit" IsEnabled="false">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding ItemEdit}" />
                        <Label>Edit</Label>
                    </StackPanel>
                </Button>
                <Button Name="mnuItemRemove" IsEnabled="false">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding ItemRemove}" />
                        <Label>Remove</Label>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8 0 0 0">
                <Button Name="mnuFind" IsEnabled="false">
                    <Image Source="{Binding Find}" />
                </Button>
                <Button Name="mnuPasswordGenerator">
                    <Image Source="{Binding PasswordGenerate}" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="2">
                <Button Name="mnuApp">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding App}" />
                        <Menu Opened="OnMenuAppOpened">
                            <MenuItem Header="▼" Classes="DropDown" Name="mnuAppDropDown">
                                <MenuItem Header="Switch to Dark Mode" Name="mnuAppDarkMode" IsVisible="false" />
                                <MenuItem Header="Switch to Light Mode" Name="mnuAppLightMode" IsVisible="false" />
                                <MenuItem Header="Options…" Name="mnuAppOptions" />
                                <MenuItem Header="-" />
                                <MenuItem Header="Send Feedback…" Name="mnuAppFeedback" />
                                <MenuItem Header="Check for Upgrade…" Name="mnuAppUpgrade" />
                                <MenuItem Header="-" />
                                <MenuItem Header="About…" Name="mnuAppAbout" />
                            </MenuItem>
                        </Menu>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main -->
        <Grid ColumnDefinitions="2*, 1*" RowDefinitions="Auto, *">
            <TextBox Name="txtFilter" Grid.Row="0" Grid.Column="0" PlaceholderText="Search..." Margin="5" />
            <ComboBox Name="cmbGroups" Grid.Row="0" Grid.Column="1" Margin="0 5 5 5" />
            <ListBox Name="lsbEntries" Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource SystemAltMediumLowColor}" SelectionChanged="lsbEntries_SelectionChanged" DoubleTapped="lsbEntries_DoubleTapped">
                <ListBox.ContextMenu>
                    <ContextMenu Opening="mnuEntry_Opening">
                        <MenuItem Header="Cu_t" Name="mnuEntryCut" InputGesture="Ctrl+X" />
                        <MenuItem Header="_Copy" Name="mnuEntryCopy" InputGesture="Ctrl+C" />
                        <MenuItem Header="_Paste" Name="mnuEntryPaste" InputGesture="Ctrl+V" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </Grid>

    </DockPanel>

</Window>