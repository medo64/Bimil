<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:apc="clr-namespace:Avalonia.PropertyGrid.Controls;assembly=Avalonia.PropertyGrid"
    x:Class="Bimil.OptionsGridWindow"
    Width="500" Height="600"
    WindowStartupLocation="CenterOwner"
    CanResize="false"
    Title="All Options">

    <DockPanel Margin="7" VerticalAlignment="Stretch">

        <DockPanel Margin="0 11 0 0" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" LastChildFill="true">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Spacing="7">
                <Button Content="_Close" Click="btnClose_Click" Name="btnClose" />
            </StackPanel>
        </DockPanel>

        <apc:PropertyGrid Name="prgSettings" IsHeaderVisible="False" IsTitleVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

    </DockPanel>

</Window>