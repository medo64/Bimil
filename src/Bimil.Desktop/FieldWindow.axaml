<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Bimil.FieldWindow"
    Width="350" Height="NaN"
    WindowStartupLocation="CenterOwner"
    CanResize="false"
    SizeToContent="Height"
    Title="Add field">

    <StackPanel Margin="7">

        <Grid ColumnDefinitions="Auto, 5, *" RowDefinitions="Auto,5,Auto,5,Auto">
            <Label Content="Field:" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" />
            <ComboBox Name="cmbFields" Grid.Column="2" Grid.Row="0" VerticalAlignment="Center" />
            <Label Name="lblCaption" Content="Caption:" Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" IsVisible="False" />
            <TextBox Name="txtCaption" Grid.Column="2" Grid.Row="2" VerticalAlignment="Center" IsVisible="False" />
            <Label Name="lblIsSensitive" Content="Sensitive:" Grid.Column="0" Grid.Row="4" VerticalAlignment="Center" IsVisible="False" />
            <CheckBox Name="chbIsSensitive" Grid.Column="2" Grid.Row="4" VerticalAlignment="Center" IsVisible="False" />
        </Grid>

        <DockPanel Margin="0 11 0 0">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="7">
                <Button Content="Save" Name="btnSave" HorizontalContentAlignment="Center" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="7">
                <Button Content="_Cancel" Name="btnCancel" HorizontalContentAlignment="Center" />
            </StackPanel>
        </DockPanel>

    </StackPanel>

</Window>
