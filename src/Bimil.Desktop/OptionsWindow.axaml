<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Bimil.OptionsWindow"
    Width="500" Height="300"
    WindowStartupLocation="CenterOwner"
    CanResize="false"
    Title="Options">

    <DockPanel Margin="7">

        <TabControl DockPanel.Dock="Top">

            <TabControl.Styles>
                <Style Selector="Button:disabled /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ComboBox">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="5" />
                </Style>
                <Style Selector="CheckBox">
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style Selector="Label">
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Foreground" Value="{DynamicResource MenuTextEnabledForeground}" />
                    <Setter Property="Margin" Value="0,0,7,0" />
                </Style>
                <Style Selector="Grid">
                    <Setter Property="ColumnSpacing" Value="3" />
                    <Setter Property="RowSpacing" Value="3" />
                </Style>
                <Style Selector="TextBox">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="5" />
                </Style>
            </TabControl.Styles>

            <TabItem Header="Behavior">
                <Grid Margin="0 7 0 0" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto, *">
                    <Label Content="Close on escape:" Grid.Row="0" Grid.Column="0" />
                    <CheckBox Name="chbCloseOnEscape" Grid.Row="0" Grid.Column="1" />

                    <Label Content="Load last:" Grid.Row="1" Grid.Column="0" />
                    <CheckBox Name="chbLoadLast" Grid.Row="1" Grid.Column="1" />

                    <Label Content="Show start window:" Grid.Row="2" Grid.Column="0" />
                    <CheckBox Name="chbShowStart" Grid.Row="2" Grid.Column="1" />

                    <Label Content="Sync clipboards:" Grid.Row="3" Grid.Column="0" />
                    <CheckBox Name="chbSyncPrimaryClipboard" Grid.Row="3" Grid.Column="1" />
                </Grid>
            </TabItem>

            <TabItem Header="UI">
                <Grid Margin="0 7 0 0" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto, *">
                    <Label Content="Theme:" Grid.Row="0" Grid.Column="0" />
                    <ComboBox Name="cmbTheme" Grid.Row="0" Grid.Column="1">
                        <ComboBoxItem>System</ComboBoxItem>
                        <ComboBoxItem>Light</ComboBoxItem>
                        <ComboBoxItem>Dark</ComboBoxItem>
                    </ComboBox>

                    <Label Content="Editable by default:" Grid.Row="1" Grid.Column="0" />
                    <CheckBox Name="chbEditableByDefault" Grid.Row="1" Grid.Column="1" />
                </Grid>
            </TabItem>

            <TabItem Header="Security">
            </TabItem>

            <TabItem Header="Two-factor">
                <Grid Margin="0 7 0 0" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto, *">
                    <Label Content="Always use NTP:" Grid.Row="0" Grid.Column="0" />
                    <CheckBox Name="chbUseNtp" Grid.Row="0" Grid.Column="1" />

                    <Label Content="NTP server:" Grid.Row="1" Grid.Column="0" />
                    <TextBox Name="txtNtpServer" Grid.Row="1" Grid.Column="1" />
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Margin="0 11 0 0" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" LastChildFill="true">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="_Defaults" Click="btnDefaults_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Spacing="7">
                <Button Content="_Save" Click="btnSave_Click" />
                <Button Content="_Cancel" Click="btnClose_Click" Name="btnClose" />
            </StackPanel>
        </DockPanel>
    </DockPanel>

</Window>