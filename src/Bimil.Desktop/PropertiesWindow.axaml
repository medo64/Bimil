<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Bimil.PropertiesWindow"
    Width="650"
    WindowStartupLocation="CenterOwner"
    CanResize="false"
    SizeToContent="Height"
    Title="Properties">

    <StackPanel Margin="7">

        <Grid ColumnDefinitions="Auto, 5, *" RowDefinitions="Auto, 11, Auto, 5, Auto, 5, Auto,  11,  Auto, 5, Auto, 5, Auto, 5, Auto, 5, Auto,  11,  Auto, 5, Auto, 5, Auto">
            <Label Content="File name:" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" />
            <TextBox Name="txtFileName" Grid.Column="2" Grid.Row="0" VerticalAlignment="Center" IsReadOnly="true" />

            <Label Content="ID:" Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" />
            <TextBox Name="txtID" Grid.Column="2" Grid.Row="2" VerticalAlignment="Center" IsReadOnly="true" />

            <Label Content="Name:" Grid.Column="0" Grid.Row="4" VerticalAlignment="Center" />
            <TextBox Name="txtName" Grid.Column="2" Grid.Row="4" VerticalAlignment="Center" />

            <Label Content="Description:" Grid.Column="0" Grid.Row="6" VerticalAlignment="Top" />
            <TextBox Name="txtDescription" Grid.Column="2" Grid.Row="6" VerticalAlignment="Center" Height="84" AcceptsReturn="true" TextWrapping="Wrap" />


            <Label Content="Last save" Grid.Column="0" Grid.Row="8" Margin="0 11 0 0" VerticalAlignment="Center" />

            <Label Content="Application:" Grid.Column="0" Grid.Row="10" Margin="11 0 0 0" VerticalAlignment="Center" />
            <TextBox Name="txtSaveApplication" Grid.Column="2" Grid.Row="10" VerticalAlignment="Center" IsReadOnly="true" />

            <Label Content="User:" Grid.Column="0" Grid.Row="12" Margin="11 0 0 0" VerticalAlignment="Center" />
            <TextBox Name="txtSaveUser" Grid.Column="2" Grid.Row="12" VerticalAlignment="Center" IsReadOnly="true" />

            <Label Content="Host:" Grid.Column="0" Grid.Row="14" Margin="11 0 0 0" VerticalAlignment="Center" />
            <TextBox Name="txtSaveHost" Grid.Column="2" Grid.Row="14" VerticalAlignment="Center" IsReadOnly="true" />

            <Label Content="Time:" Grid.Column="0" Grid.Row="16" Margin="11 0 0 0" VerticalAlignment="Center" />
            <TextBox Name="txtSaveTime" Grid.Column="2" Grid.Row="16" VerticalAlignment="Center" IsReadOnly="true" />


            <Label Content="Key" Grid.Column="0" Grid.Row="18" Margin="0 11 0 0" VerticalAlignment="Center" />

            <Label Content="Show:" Grid.Column="0" Grid.Row="20" Margin="11 0 0 0" VerticalAlignment="Center" />
            <CheckBox Name="chbShowKey" Grid.Column="2" Grid.Row="20" VerticalAlignment="Center" />

            <Label Content="Encryption Key:" Grid.Column="0" Grid.Row="22" Margin="11 0 0 0" VerticalAlignment="Center" />
            <TextBox Name="txtEncryptionKey" Grid.Column="2" Grid.Row="22" VerticalAlignment="Center" IsReadOnly="true" />

        </Grid>

        <DockPanel Margin="0 11 0 0">
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="7">
                <Button Content="_Save" Click="btnSave_Click" HorizontalContentAlignment="Center" />
                <Button Content="_Close" Name="btnClose" Click="btnClose_Click" HorizontalContentAlignment="Center" />
            </StackPanel>
        </DockPanel>

    </StackPanel>

</Window>
