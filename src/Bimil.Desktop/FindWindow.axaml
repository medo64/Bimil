<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Bimil.FindWindow"
    Width="500" Height="600"
    WindowStartupLocation="CenterOwner"
    CanResize="false"
    Title="Search">

    <DockPanel Margin="7" VerticalAlignment="Stretch">

        <DockPanel Margin="0 11 0 0" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" LastChildFill="true">
            <Grid ColumnDefinitions="*,Auto" DockPanel.Dock="Right" HorizontalAlignment="Stretch">
                <CheckBox Name="chbSearchSensitive" Content="Search sensitive fields" Grid.Row="0" Grid.Column="0" ToolTip.Tip="If set, password fields will be included in the search." />
                <Button Name="btnClose" Content="_Close" Grid.Row="0" Grid.Column="1" />
            </Grid>
        </DockPanel>

        <TextBox Name="txtFilter" PlaceholderText="Search..." Margin="5" DockPanel.Dock="Top" />

        <ScrollViewer DockPanel.Dock="Top">
            <ListBox Name="lsbEntries" Background="{DynamicResource SystemAltMediumLowColor}" />
        </ScrollViewer>

    </DockPanel>

</Window>
