<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Bimil.FieldsWindow"
    Width="600" Height="400"
    WindowStartupLocation="CenterOwner"
    CanResize="false"
    Title="Fields">

    <DockPanel Margin="7" VerticalAlignment="Stretch">

        <DockPanel Margin="0 11 0 0" DockPanel.Dock="Bottom">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="7">
                <Button Content="_Add" Name="btnAdd" HorizontalContentAlignment="Center" />
                <Button Content="_Remove" Name="btnRemove" IsEnabled="False" HorizontalContentAlignment="Center" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="7">
                <Button Content="_Save" Name="btnSave" IsEnabled="False" HorizontalContentAlignment="Center" />
                <Button Content="_Cancel" Name="btnCancel" HorizontalContentAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <ListBox Name="lsbFields" DockPanel.Dock="Top">
            <ListBox.Template>
                <ControlTemplate>
                    <ScrollViewer>
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ListBox.Template>
        </ListBox>

    </DockPanel>

</Window>