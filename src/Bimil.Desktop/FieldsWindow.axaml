<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Bimil.FieldsWindow"
    Width="400" Height="400"
    WindowStartupLocation="CenterOwner"
    CanResize="false"
    Title="Fields">

    <DockPanel Margin="7" HorizontalAlignment="Stretch">

        <DockPanel Margin="11 0 0 0" DockPanel.Dock="Right">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Spacing="7">
                    <Button Content="_Save" TabIndex="4" Name="btnSave" IsEnabled="False" />
                    <Button Content="_Cancel" TabIndex="5" Name="btnCancel" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="7">
                    <Button Content="_Add" TabIndex="1" Name="btnAdd" />
                    <Button Content="_Edit" TabIndex="2" Name="btnEdit" IsEnabled="False" />
                    <Button Content="_Remove" TabIndex="3" Name="btnRemove" IsEnabled="False" />
                </StackPanel>
            </DockPanel>
        </DockPanel>

        <ListBox Name="lsbFields" TabIndex="0" DockPanel.Dock="Left">
            <ListBox.Template>
                <ControlTemplate>
                    <ScrollViewer>
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ListBox.Template>
        </ListBox>

    </DockPanel>

</Window>